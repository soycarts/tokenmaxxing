# Supabase project (Project Settings → API). Without these the site builds and shows a
# "not connected" state everywhere.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Server only. Used by /api/v1/push, /api/v1/link, /link, device revoke and account delete.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Canonical origin, used in badge snippets.
NEXT_PUBLIC_SITE_URL=https://tokenmaxxing.fyi

# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET` to /api/cron/refresh.
CRON_SECRET=<long random string>

# Optional, tests only: a Postgres URL with schema.sql applied runs supabase/schema.test.sql.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

